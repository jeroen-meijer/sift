{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "e2e",
          "description": "WebDriverIO ACL for e2e builds only",
          "windows": ["main"],
          "permissions": ["wdio:default"]
        }
      ]
    }
  },
  "build": {
    "beforeBuildCommand": "VITE_E2E=1 bun run build"
  }
}
