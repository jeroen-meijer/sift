{
  "name": "sift",
  "private": true,
  "version": "0.5.1",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:docs": "markdownlint-cli2",
    "docs:check": "bun tool/check-docs.ts && bun run i18n:check && bun run lint:docs",
    "docs:links": "bun tool/check-links.ts",
    "i18n:check": "bun tool/check-i18n.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "test:e2e:browser": "wdio run e2e/wdio.browser.conf.ts",
    "build:e2e:app": "bun tool/build-e2e-app.ts",
    "test:e2e:tauri": "wdio run e2e/wdio.tauri.conf.ts",
    "test:e2e": "bun run test:e2e:browser && bun run test:e2e:tauri",
    "tauri": "tauri",
    "tauri:dev": "bun tool/sync-version.ts && tauri dev",
    "tauri:build": "bun tool/build-tauri.ts",
    "tauri:profile": "bun scripts/tauri-profile.ts",
    "version:sync": "bun tool/sync-version.ts",
    "version:set": "bun tool/sync-version.ts",
    "preflight": "./tool/preflight.sh"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "2",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "i18next": "^26.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "@wdio/types": "9.32.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "expect-webdriverio": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "markdownlint-cli2": "^0.23.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4",
    "webdriverio": "^9.32.0",
    "yaml": "^2.8.0"
  }
}
