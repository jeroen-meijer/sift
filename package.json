{
  "name": "sift",
  "private": true,
  "version": "0.3.2",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "tauri": "tauri",
    "tauri:dev": "bun tool/sync-version.ts && tauri dev",
    "tauri:build": "bun tool/build-tauri.ts",
    "tauri:profile": "bun scripts/tauri-profile.ts",
    "version:sync": "bun tool/sync-version.ts",
    "version:set": "bun tool/sync-version.ts",
    "preflight": "./tool/preflight.sh"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "2",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "i18next": "^26.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  }
}
